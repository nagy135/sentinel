# Copy to .env to override these settings. Bun loads .env automatically.
PORT=3000
SENTINEL_HOST=127.0.0.1
SENTINEL_INTERVAL_MS=5000
SENTINEL_DB_PATH=./data/sentinel.sqlite

# Required: set these privately before running. Never commit your .env.
SENTINEL_USERNAME=
SENTINEL_PASSWORD=
# Set the external origin when running behind an HTTPS reverse proxy.
# SENTINEL_PUBLIC_URL=https://status.example.com
